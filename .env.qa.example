# INVEN3 Windows QA client configuration.
# Copy to .env.qa.local and fill the existing public QA client values once.
# Do not commit .env.qa.local. Never place service_role or user credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# QA release identity shared with the Web and Android QA candidates.
VITE_RELEASE_ENV=qa
VITE_RELEASE_CHANNEL=beta
VITE_RELEASE_VERSION=1.0.0
VITE_APP_BUILD=
VITE_APP_VERSION=
