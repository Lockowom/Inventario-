{
  "name": "inven3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test --project=visual",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/services/supabase.types.ts",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android",
    "cap:ios": "npm run build && cap sync ios",
    "certify:f9b:remote-rp": "node scripts/f9b-remote-rp-certification.mjs",
    "certify:f9b:remote-f8": "node --experimental-strip-types scripts/f9b-remote-f8-certification.mjs",
    "certify:f9b:auto-offline": "npm run typecheck && vitest run tests/unit/phase-9-offline-certification.test.ts tests/unit/count-storage.test.ts tests/unit/counting-capture-gate.test.tsx tests/unit/sync-manager.test.ts tests/unit/auth-boundary-state.test.ts tests/unit/auth-service.test.ts tests/unit/scanner-health-probe.test.ts",
    "certify:f9b:auto-all": "npm run typecheck && npm run test && npm run test:e2e && npm run test:visual && npm run build",
    "certify:f9b:android-device": "node scripts/f9b-android-device-certification.mjs",
    "certify:f9b:complete": "npm run certify:f9b:auto-all && npm run certify:f9b:android-device",
    "certify:f9b:android-fresh": "node scripts/f9b-android-fresh-certification.mjs",
    "certify:f9b:beta-signoff": "node scripts/f9b-beta-manual-signoff.mjs",
    "certify:f9b:rp-source": "node scripts/f9b-rp-source-certification.mjs",
    "test:ios:virtual": "playwright test --project=ios-webkit",
    "preview:ios": "node scripts/ios-virtual-preview.mjs",
    "setup:ios:virtual": "playwright install webkit",
    "preview:ios:lab": "node scripts/ios-device-lab.mjs",
    "preview:ios:matrix": "node scripts/ios-device-matrix.mjs",
    "certify:f9b:ios-matrix": "node scripts/f9b-ios-matrix-certification.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:preflight:static": "node scripts/release-preflight.mjs --static",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:qa": "npm run release:preflight && npm run build && npm run release:audit-bundle && npm run release:manifest",
    "release:verify-native-web": "node scripts/release-native-web-verify.mjs",
    "release:verify-candidate": "node scripts/release-candidate-verify.mjs",
    "release:audit-bundle": "node scripts/release-bundle-audit.mjs",
    "release:verify-parity": "node scripts/release-candidate-parity.mjs",
    "release:smoke:check": "node scripts/f10a-smoke-evidence-check.mjs",
    "release:f10a:close": "node scripts/f10a-close.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.0.0",
    "dexie": "^4.0.0",
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "supabase": "2.114.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
