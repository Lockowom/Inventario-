# Backend runtime (public client credentials only; never service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Release channel identity. The functional version is always read from version.json.
VITE_RELEASE_ENV=qa
VITE_RELEASE_CHANNEL=beta
VITE_APP_BUILD=

# Optional legacy/display override used by certification builds
VITE_APP_VERSION=
